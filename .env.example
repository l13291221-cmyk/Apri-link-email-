# Copia questo file in ".env" e riempi i valori PER I TEST IN LOCALE.
# Il file ".env" e' ignorato da git: non verra' mai caricato su GitHub.
# Su GitHub Actions NON usare questo file: usa i Secrets (vedi README).

# --- Gmail (serve una "Password per le app", non la password normale) ---
GMAIL_USER=tuoindirizzo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Bidoo ---
BIDOO_USER=Minonne49
BIDOO_PASS=la-tua-password-bidoo

# --- Opzioni (facoltative) ---
# Sottostringa cercata nel mittente per riconoscere le email Bidoo
BIDOO_FROM=bidoo
# Quante email al massimo processare per esecuzione
MAX_EMAILS=5
# Segna le email come lette dopo averle processate
MARK_SEEN=true
# Clicca tutti i link Bidoo dell'email (true) o solo il primo (false)
CLICK_ALL=false
# Prova senza cliccare/loggare: stampa solo cosa farebbe
DRY_RUN=false
# In locale metti false per vedere il browser; su Actions deve restare true
HEADLESS=true
